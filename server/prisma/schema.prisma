// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role         @default(OFFICIAL)
  createdAt    DateTime     @default(now())
  assignments  Assignment[]
}

enum Role {
  ADMIN
  OFFICIAL
}

model Game {
  id          String       @id @default(cuid())
  sport       Sport
  startTime   DateTime
  location    String
  level       String?
  homeTeam    String?
  awayTeam    String?
  slotsNeeded Int          @default(2)
  notes       String?
  createdAt   DateTime     @default(now())
  assignments Assignment[]
}

enum Sport {
  BASKETBALL
  SOFTBALL
  SOCCER
  FLAG_FOOTBALL
  VOLLEYBALL
}

model Assignment {
  id        String           @id @default(cuid())
  game      Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  official  User             @relation(fields: [userId], references: [id])
  userId    String
  position  String?
  status    AssignmentStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([gameId, userId])
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}